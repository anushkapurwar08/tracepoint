{
  "name": "SignalOS \u2014 Feedback intake & critical-issue alerts",
  "nodes": [
    {
      "id": "73fd7959-d45e-41f6-a590-9d6ca014d158",
      "name": "Webhook: new feedback",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "signalos-feedback",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "ec3c48dd-07ee-4523-b96b-8881bb512b46",
      "name": "Analyse in SignalOS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8000/feedback",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ content: $json.body.content, source: $json.body.source || 'n8n', user_id: $json.body.user_id || null }) }}",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "78a12dd5-ca09-4b6b-bd0d-07968fb64da4",
      "name": "Is issue P0/P1?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        480,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "0e5c0896-6f8a-40fc-aa9b-463f4ea26e6b",
              "leftValue": "={{ $json.issue ? $json.issue.priority : '' }}",
              "rightValue": "P0",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "7e7b7db9-25d0-4cb0-817e-7e9bc8ad8726",
              "leftValue": "={{ $json.issue ? $json.issue.priority : '' }}",
              "rightValue": "P1",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      }
    },
    {
      "id": "61b9649a-e3d3-431f-b2e0-207819d41fc3",
      "name": "Alert #product-alerts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "https://hooks.slack.com/services/REPLACE_ME",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: `:rotating_light: ${$json.issue.priority} ${$json.issue.title}\\n${$json.issue.feedback_count} reports \u00b7 ${$json.issue.explanation}` }) }}",
        "options": {}
      }
    },
    {
      "id": "f06fe305-5aed-4051-bd4e-c15de284e1d5",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        960,
        300
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ status: 'processed', feedback_id: $('Analyse in SignalOS').item.json.feedback_id, priority: $('Analyse in SignalOS').item.json.decision.priority, issue: $('Analyse in SignalOS').item.json.issue }) }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Webhook: new feedback": {
      "main": [
        [
          {
            "node": "Analyse in SignalOS",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Analyse in SignalOS": {
      "main": [
        [
          {
            "node": "Is issue P0/P1?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is issue P0/P1?": {
      "main": [
        [
          {
            "node": "Alert #product-alerts",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Alert #product-alerts": {
      "main": [
        [
          {
            "node": "Respond",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}