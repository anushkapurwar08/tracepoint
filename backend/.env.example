# Copy to .env and fill in. Every key is optional: missing keys switch that
# component to a clearly labelled fallback (shown on the dashboard header).

# Jev (TypeSafe AI) — console.typesafe.ai
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest

# Gemini — aistudio.google.com → Get API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Database. Default is local SQLite. For Supabase use the Postgres URI, with
# the driver prefix, e.g.:
# DATABASE_URL=postgresql+psycopg://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_URL=sqlite:///./signalos.db

# Where P0/P1 tickets get POSTed (e.g. your n8n "create ticket" webhook). Empty = stored locally.
TICKET_WEBHOOK_URL=

# Tuning
SEMANTIC_THRESHOLD=0.45
W_SEVERITY=0.40
W_VOLUME=0.30
W_CHURN=0.20
W_RECENCY=0.10
